{
  "name": "den-kit",
  "private": true,
  "type": "module",
  "description": "den-kit PoC: patch den blocks in a graph editor, with AI collaboration (GEN-648).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "vite": "vite",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "build": "npm run check && vite build",
    "doctor": "node scripts/doctor.ts",
    "codex:login": "node scripts/codex-login.ts",
    "fake:jev": "node test/fakes/jev/fake-jev.ts",
    "eval:jev": "node scripts/eval-jev.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@fontsource/monoton": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@leaningtech/browserpod": "3.4.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "highlight.js": "11.12.0",
    "vue": "3.5.43",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.9",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "optionalDependencies": {
    "@openai/codex": "0.160.1"
  }
}
