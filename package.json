{
  "name": "den-kit",
  "version": "0.1.2",
  "author": "Escentier, LLC",
  "private": true,
  "type": "module",
  "description": "Visual editor for instruments and effects built from den blocks.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "vite": "vite",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "build": "npm run check && vite build",
    "desktop:build": "npm run build && node scripts/build-desktop.ts",
    "desktop:run": "node scripts/run-desktop.ts",
    "desktop:clean": "node scripts/clean-desktop.ts",
    "desktop:icons": "node scripts/generate-icons.ts",
    "desktop:check": "node scripts/check-desktop.ts --packaged",
    "desktop:package": "npm run desktop:build && electron-builder --config electron-builder.yml --dir --mac -c.mac.identity=null",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.yml --mac --publish never",
    "desktop:check-artifacts": "node scripts/check-desktop-artifacts.ts",
    "desktop:check-update": "node scripts/check-desktop-update.ts",
    "doctor": "node scripts/doctor.ts",
    "codex:login": "node scripts/codex-login.ts",
    "release:version": "node scripts/release-version.ts"
  },
  "dependencies": {
    "@denaudio/den": "0.1.0",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@fontsource/monoton": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@leaningtech/browserpod": "3.4.0",
    "@unworklet/core": "0.4.1",
    "@unworklet/offline": "0.4.1",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "electron-updater": "6.8.10",
    "highlight.js": "11.12.0",
    "vue": "3.5.43",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "optionalDependencies": {
    "@openai/codex": "0.160.1"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/den-kit.git"
  }
}
