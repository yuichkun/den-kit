{
  "name": "den-kit",
  "private": true,
  "type": "module",
  "description": "den-kit PoC: patch den blocks in a graph editor, with AI collaboration (GEN-648).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "vite": "vite",
    "bridge": "node bridge/server.ts",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "build": "npm run check && vite build",
    "doctor": "node scripts/doctor.ts"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "vue": "3.5.43",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.9",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "optionalDependencies": {
    "@openai/codex": "0.160.1"
  }
}
